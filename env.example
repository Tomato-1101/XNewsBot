# XNewsBot 環境変数テンプレート。`cp env.example .env` して値を埋める。
# .env はコミットしない(.gitignore済み)。
#
# ※ ニュースのキュレーション(束ね・重要度判定・要約)は Claude Code(サブスク)の
#    定期実行で行う方針のため、Anthropic API キーは不要(設定しない)。
# ※ 配信は1日2回(朝=morning / 夜=evening スロット)。各スロットで最新を収集し直すため、
#    キュレーションの定期実行も朝・夜の2回(各配信時刻の少し前)に走らせる。
#    配信ジャンルとキーワードは config/genres.toml で編集する。

# --- LINE Messaging API ---
# LINE Developers Console (https://developers.line.biz/console/) で
# Messaging API チャネルを作成して取得する。
# ACCESS_TOKEN: 配信(push)に必須。
# SECRET: Webhook(Bot対話・見出しタップで詳細)を使う場合に必要。push のみなら空でよい。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- twitterapi.io (Xの読み取り) ---
# 空なら macOS Keychain (service=twitterapi_io_key) を自動で読む(x-research と共有)。
# 複数アカウントのキーはカンマ区切りで優先度順に並べられる(先頭が最優先。429/失敗で次へ)。
# 例: TWITTERAPI_IO_KEY=key_primary,key_secondary  (.key ファイルなら1行1キーでも可)
TWITTERAPI_IO_KEY=

# --- 動作 ---
DB_PATH=xnewsbot.db
PORT=8010
DEFAULT_TZ=Asia/Tokyo

# 管理Web UI(xnewsbot.admin, :8011)のログインパスワード(HTTP Basic)。
# LAN 公開するため必須。未設定だと管理UIは起動しない。ユーザー名は任意。
XNEWSBOT_ADMIN_PASSWORD=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# 1ジャンルあたり収集するツイート上限(課金/レート対策)
COLLECT_MAX_TWEETS=120
# 収集対象の直近時間(時間)
COLLECT_HOURS=24
# 収集時の最低いいね数(ノイズ除去)
COLLECT_MIN_FAVES=200
