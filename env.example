# XNewsBot 環境変数テンプレート。`cp env.example .env` して値を埋める。
# .env はコミットしない(.gitignore済み)。

# --- Claude (ニュースキュレーション) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- LINE Messaging API ---
# LINE Developers Console (https://developers.line.biz/console/) で
# Messaging API チャネルを作成し取得する。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- twitterapi.io (Xの読み取り) ---
# 空なら macOS Keychain (service=twitterapi_io_key) を自動で読む(x-research と共有)。
TWITTERAPI_IO_KEY=

# --- 動作 ---
DB_PATH=xnewsbot.db
PORT=8010
DEFAULT_TZ=Asia/Tokyo
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# 1ジャンルあたり収集するツイート上限(課金/レート対策)
COLLECT_MAX_TWEETS=120
# 収集対象の直近時間(時間)
COLLECT_HOURS=24
# 収集時の最低いいね数(ノイズ除去)
COLLECT_MIN_FAVES=200
