<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  XNewsBot リアルタイム配信(朝08:00 / 夜21:00 着)を macOS LaunchAgent で起動する。
  ~/Library/LaunchAgents/com.tomato.xnewsbot-deliver.plist に配置する。
  収集に約2分かかるため、配信時刻の【5分前】(07:55 / 20:55)に起動して先に収集・
  キュレーションを始め、ops/deliver.sh が定刻ちょうど(08:00 / 21:00)まで待ってから LINE 送信する
  (=その時刻までの最新を、届く時刻を揃えて配信)。
  常駐サーバ(com.tomato.xnewsbot)は LINE Webhook の受信(オンボーディング/設定/今すぐ配信)専任。

  ※ 起動は配信時刻の5分前。配信時刻を変えたら、この plist の Hour/Minute(5分前)と
     deliver.sh の MORNING_HHMM / EVENING_HHMM(定刻)の両方を合わせて更新する。
  ※ Mac がスリープ等でこの時刻に起動を逃しても、launchd は次回の起床時に1回だけ遅れて実行する
     (=起床時点の最新を届ける)。

  管理:
    起動  : launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tomato.xnewsbot-deliver.plist
    停止  : launchctl bootout  gui/$(id -u)/com.tomato.xnewsbot-deliver
    手動実行: launchctl kickstart -k gui/$(id -u)/com.tomato.xnewsbot-deliver
    状態  : launchctl list | grep xnewsbot-deliver
    ログ  : ~/Library/Logs/xnewsbot-deliver.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomato.xnewsbot-deliver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tomato/Project/XNewsBot/ops/deliver.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/tomato/Project/XNewsBot</string>

    <!-- 配信時刻(08:00 / 21:00)の5分前に起動し、収集→キュレーション後に定刻まで待って送信 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>55</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>55</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/tomato/Library/Logs/xnewsbot-deliver.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomato/Library/Logs/xnewsbot-deliver.err.log</string>
</dict>
</plist>
