<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ngrok トンネル(固定ドメイン → localhost:18010)を macOS LaunchAgent で常駐させる。
  ~/Library/LaunchAgents/com.tomato.xnewsbot-ngrok.plist に配置する。
  これでターミナルを開きっぱなしにしなくてよく、ログイン時に自動起動・落ちても自動再起動する。

  ※ 固定ドメイン YOUR-STATIC-DOMAIN.ngrok-free.dev は tomato のアカウントに予約済み。
     変更する場合は下の --url を書き換え、LINE の Webhook URL も合わせて更新する。
  ※ authtoken は ~/Library/Application Support/ngrok/ngrok.yml から自動で読まれる。
  ※ launchd には端末が無いので --log=stdout で TUI を無効化(これが無いと起動に失敗する)。

  管理:
    起動  : launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tomato.xnewsbot-ngrok.plist
    停止  : launchctl bootout  gui/$(id -u)/com.tomato.xnewsbot-ngrok
    再起動: launchctl kickstart -k gui/$(id -u)/com.tomato.xnewsbot-ngrok
    状態  : launchctl list | grep xnewsbot-ngrok
    ログ  : ~/Library/Logs/xnewsbot-ngrok.log
    公開URL確認: curl -s http://127.0.0.1:4040/api/tunnels
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomato.xnewsbot-ngrok</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ngrok</string>
        <string>http</string>
        <string>--url=https://YOUR-STATIC-DOMAIN.ngrok-free.dev</string>
        <string>--log=stdout</string>
        <string>18010</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/tomato</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/tomato/Library/Logs/xnewsbot-ngrok.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomato/Library/Logs/xnewsbot-ngrok.log</string>
</dict>
</plist>
